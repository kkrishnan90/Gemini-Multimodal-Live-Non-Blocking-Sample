# Sophie Assistant Configuration
# ================================
# Choose ONE authentication mode: AI_STUDIO or VERTEX_AI

# Authentication Mode: "AI_STUDIO" or "VERTEX_AI"
AUTH_MODE=VERTEX_AI

# -----------------------------
# AI Studio Configuration
# -----------------------------
# Required when AUTH_MODE=AI_STUDIO
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# -----------------------------
# Vertex AI Configuration
# -----------------------------
# Required when AUTH_MODE=VERTEX_AI
# Ensure Google Cloud ADC is configured: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# -----------------------------
# Model Settings
# -----------------------------
# AI Studio model ID (used when AUTH_MODE=AI_STUDIO)
MODEL_ID_AI_STUDIO=gemini-2.5-flash-native-audio-preview-12-2025
# Vertex AI model ID (used when AUTH_MODE=VERTEX_AI)
MODEL_ID_VERTEX_AI=gemini-live-2.5-flash-native-audio

# -----------------------------
# Voice Settings
# -----------------------------
# Voice options: Aoede, Charon, Fenrir, Kore, Puck
VOICE_NAME=Kore
LANGUAGE_CODE=en-IN

# -----------------------------
# VAD (Voice Activity Detection) Settings
# -----------------------------
# Disable automatic VAD (if true, client must send manual activity signals)
VAD_DISABLED=false

# Start of speech sensitivity: LOW (less sensitive, fewer false triggers) or HIGH (more sensitive)
START_OF_SPEECH_SENSITIVITY=HIGH

# End of speech sensitivity: LOW (waits longer for user to finish) or HIGH (ends speech quickly)
END_OF_SPEECH_SENSITIVITY=HIGH

# Duration of silence (ms) before end-of-speech is committed (higher = longer pauses allowed)
SILENCE_DURATION_MS=500

# Duration of speech (ms) before start-of-speech is committed (lower = more responsive)
PREFIX_PADDING_MS=300

# Allow user to interrupt model's response (barge-in)
BARGE_IN=true

# Enable proactive audio from the model (Vertex AI only)
PROACTIVE_AUDIO=false
